<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

 <form action="/new-organization" method="POST" class="form-card">
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input
        required
        maxlength="150"
        type="text"
        id="name"
        name="name"
      />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        required
        maxlength="150"
        id="description"
        name="description"
      ></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input
        required
        type="email"
        id="contactEmail"
        name="contactEmail"
      />
    </div>

    <button type="submit" class="button">Create Organization</button>
  </form>

</main>
<%- include('partials/footer') %>
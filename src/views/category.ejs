<%- include("partials/header") %>

<main>

  <section class="page-header">
    <div>
      <span class="eyebrow">CATEGORY</span>

      <h1><%= category.name %></h1>

      <div class="page-actions">
        <a
          href="/edit-category/<%= category.category_id %>"
          class="button"
        >
          Edit Category
        </a>
      </div>
    </div>
  </section>

  <section class="section">

    <div class="page-header">
      <div>
        <span class="eyebrow">SERVICE PROJECTS</span>
        <h2>Projects in this Category</h2>
      </div>
    </div>

    <div class="project-list">

      <% if (projects.length > 0) { %>

        <% projects.forEach((project) => { %>

          <article class="project-card">

            <div class="project-content">

              <h3>
                <a href="/project/<%= project.project_id %>">
                  <%= project.title %>
                </a>
              </h3>

              <p>
                <%= project.description %>
              </p>

              <p>
                <strong>Date:</strong>
                <%= new Date(project.eventdate).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                  timezone: 'UTC'
                }) %>
              </p>

              <p>
                <strong>Location:</strong>
                <%= project.location %>
              </p>

            </div>

          </article>

        <% }) %>

      <% } else { %>

        <p>
          No service projects are currently assigned to this category.
        </p>

      <% } %>

    </div>

  </section>

</main>

<%- include("partials/footer") %>
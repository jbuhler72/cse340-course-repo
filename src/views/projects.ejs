<%- include('partials/header') %>

<main>
  <h1><%= title %></h1>
  <p>Explore available service projects.</p>
  <span>
            <p><a href="/new-project">Add a New Service Project</a></p>
        </span>
  <section>
    <% upcomingProjects.forEach(project => { %>
      <article>
        <h2><a href="/project/<%= project.project_id %>"><%= project.title %></a></h2>
        <p><strong>Organization:</strong> <%= project.organization_name %></p>
        <p>
          <strong>Date:</strong>
          <%= new Date(project.eventdate).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          }) %>
        </p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p><%= project.description %></p>
      </article>
    <% }) %>
  </section>

</main>

<%- include('partials/footer') %>

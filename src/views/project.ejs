<%- include('partials/header') %>
<main>

  <section class="page-header">
    <div>
      <span class="eyebrow">PROJECT</span>
      <h1><%= projectDetails.title %></h1>

      <div class="page-actions">
        <a href="/edit-project/<%= projectDetails.project_id %>" class="button">Edit Project</a>
        <a href="/assign-categories/<%= projectDetails.project_id %>" class="button">Edit Categories</a>
      </div>
    </div>
  </section>

  <p><strong>Description:</strong> <%= projectDetails.description %></p>
  <p>
    <strong>Date:</strong>
    <%= new Date(projectDetails.eventdate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    }) %>
  </p>
  <p><strong>Location:</strong> <%= projectDetails.location %></p>
  <p>
    <strong>Organization:</strong>
    <a href="/organization/<%= projectDetails.organization_id %>">
      <%= projectDetails.organization_name %>
    </a>
  </p>

  <section class="section">
    <div class="page-header">
      <div>
        <span class="eyebrow">CATEGORIES</span>
        <h2>Categories For This Project</h2>
      </div>
    </div>

    <% if (categoryDetails.length === 0) { %>
      <p>This project does not have any categories.</p>
    <% } else { %>
      <ul class="category-tags">
        <% categoryDetails.forEach((category) => { %>
          <li>
            <a class="category-tag" href="/category/<%= category.category_id %>">
              <%= category.category %>
            </a>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </section>

</main>
<%- include('partials/footer') %>

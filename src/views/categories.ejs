<%- include("partials/header") %>

<main>
    <span class="eyebrow eyebrow-teal">CATEGORIES</span>
    <h1><%= title %></h1>
    <% if (user && user.role_name === 'admin') { %>
    <div class="page-actions page-actions-center">
        <a href="/new-category" class="button button-teal">Add a New Category</a>
    </div>
    <% } %>
    <section class="categories">
        <% categories.forEach(category => { %>
            <div class="category-card">
                <div class="category-icon"><%= category.category.charAt(0) %></div>
                <h2><a
              class="category-tag"
              href="/category/<%= category.category_id %>"
            >
              <%= category.category %>
            </a></h2>
            </div>
        <% }) %>
    </section>
</main>

<%- include("partials/footer") %>
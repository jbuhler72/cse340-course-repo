<%- include("partials/header") %>

<main>
    <h1><%= title %></h1>

    <section class="categories">
        <% categories.forEach(category => { %>
            <div class="category-card">
                <div class="category-icon"><%= category.name.charAt(0) %></div>
                <h2><%= category.name %></h2>
                <p><%= category.description %></p>
            </div>
        <% }) %>
    </section>
</main>

<%- include("partials/footer") %>